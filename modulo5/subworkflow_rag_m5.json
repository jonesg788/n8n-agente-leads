    {
      "parameters": {
        "jsCode": "// Minimum Score: descarta los fragmentos con similitud menor al umbral\n// y devuelve el contexto con la cita de la sección.\nconst entrada = $('Entrada normalizada (Top-K y Minimum Score)').first().json;\nconst minScore = Number(entrada.min_score);\nconst origen = $('Recuperar fragmentos tras indexar (Top-K)').isExecuted ? $('Recuperar fragmentos tras indexar (Top-K)').all() : $('Recuperar fragmentos (Top-K)').all();\nconst docs = origen\n  .map(i => ({ score: Number(i.json.score ?? 0), texto: i.json.document?.pageContent ?? '', seccion: i.json.document?.metadata?.seccion ?? 'sin sección' }))\n  .filter(d => d.texto);\nconst relevantes = docs.filter(d => d.score >= minScore);\nconst base = {\n  consulta: entrada.consulta, top_k: entrada.top_k, min_score: minScore,\n  reindexado: $('Recuperar fragmentos tras indexar (Top-K)').isExecuted,\n  fragmentos_recuperados: docs.length, fragmentos_usados: relevantes.length,\n  scores: docs.map(d => d.seccion + ' = ' + d.score.toFixed(3)).join(' | ')\n};\nif (relevantes.length === 0) {\n  return [{ json: { resultado: 'SIN_FRAGMENTOS_RELEVANTES: ningún fragmento del Manual de Servicios Sowe v1.0 supera el umbral de relevancia. Responde exactamente con la regla \"No sé\".', ...base } }];\n}\nconst contexto = relevantes.map((d, i) =>\n  `[Fragmento ${i + 1} · Fuente: Manual de Servicios Sowe v1.0, §${d.seccion} · score ${d.score.toFixed(3)}]\\n${d.texto}`\n).join('\\n\\n---\\n\\n');\nreturn [{ json: { resultado: contexto, ...base } }];"
      },
      "id": "cc6a0456-d530-4bfe-ab62-2125ae03fd3e",
      "name": "Filtro Minimum Score y citas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        0
      ],
      "executeOnce": true
    }
