      "id": "c9d684e6-3b62-40db-9c83-b85ac248871e",
      "name": "Ingesta - Descargar manual curado (Markdown)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Chunking semántico: un fragmento por subsección del manual (## / ###),\n// con la sección como metadata para poder citarla.\nconst md = String($input.first().json.data ?? '');\nconst out = [];\nlet h2 = '', h3 = '', buf = [];\nconst flush = () => {\n  const texto = buf.join('\\n').trim();\n  if (texto) out.push({ json: { seccion: h3 || h2 || 'Datos del documento', seccion_padre: h2 || 'Encabezado', texto } });\n  buf = [];\n};\nfor (const linea of md.split('\\n')) {\n  if (linea.startsWith('# ')) continue;\n  if (linea.startsWith('## ')) { flush(); h2 = linea.slice(3).trim(); h3 = ''; continue; }\n  if (linea.startsWith('### ')) { flush(); h3 = linea.slice(4).trim(); continue; }\n  buf.push(linea);\n}\nflush();\nreturn out;"
      },
